// Shared build settings for Tonic and its widget.
//
// To run on your own iPhone, copy Local.xcconfig.example to Local.xcconfig and fill it in.
// Local.xcconfig is git-ignored, so your team ID never ends up in a commit.

// Bundle IDs and the App Group are built from this prefix. Change it in Local.xcconfig
// to something you own (e.g. com.yourname) when signing with your own team.
TONIC_BUNDLE_PREFIX = com.tonicapp

#include? "Local.xcconfig"

TONIC_APP_GROUP = group.$(TONIC_BUNDLE_PREFIX).Tonic
